# Environment Configuration for Deepfake Shield

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-super-secret-jwt-key-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deepfake_shield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=deepfake_shield
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=500

# AI Models & Hardware Acceleration
DEVICE=cpu # 'cuda', 'mps', or 'cpu'
FACE_DETECTION_CONFIDENCE=0.65
LIP_SYNC_THRESHOLD_MS=80.0
SYNTHETIC_SPEECH_THRESHOLD=0.75
SPATIAL_MANIPULATION_THRESHOLD=0.70

# Real-Time Streaming
STREAM_BUFFER_SECONDS=2.0
STREAM_FPS=10
STREAM_AUDIO_SAMPLE_RATE=16000

# Hugging Face Dataset API
HF_TOKEN=hf_your_optional_api_token_here
HF_DEFAULT_DATASET=UniDataPro/deepfake-videos-dataset
HF_CACHE_TTL_SECONDS=300
HF_REQUEST_TIMEOUT_SECONDS=15.0

